# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
# Must be a Replica Set URI for transactions to work
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/kuditrack?appName=Cluster0

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# ─── Email (OTP) ──────────────────────────────────────────
# Use any SMTP provider: Gmail, Resend, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="KudiTrack <noreply@kuditrack.com>"

# ─── Admin ────────────────────────────────────────────────
ADMIN_EMAILS=admin@example.com
